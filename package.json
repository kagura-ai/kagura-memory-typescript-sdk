{
  "name": "kagura-memory",
  "version": "0.8.0",
  "description": "TypeScript SDK for Kagura Memory Cloud — memory management, graph exploration, and R2 file storage for AI agents",
  "keywords": [
    "ai",
    "memory",
    "mcp",
    "agent",
    "llm",
    "kagura",
    "rag",
    "embeddings",
    "vector-search"
  ],
  "license": "MIT",
  "author": "Kagura AI <dev@kagura-ai.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagura-ai/kagura-memory-typescript-sdk.git"
  },
  "homepage": "https://github.com/kagura-ai/kagura-memory-typescript-sdk",
  "bugs": {
    "url": "https://github.com/kagura-ai/kagura-memory-typescript-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "kagura-memory": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:no-webcrypto": "vitest run --config vitest.no-webcrypto.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run test:no-webcrypto && npm run build"
  },
  "peerDependencies": {
    "age-encryption": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "age-encryption": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "age-encryption": "^0.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
